<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Template Form View -->
    <record id="view_product_template_form_multicompany" model="ir.ui.view">
        <field name="name">product.template.form.multicompany</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="groups">base.group_multi_company</attribute>
            </field>
            <field name="company_id" position="after">
                <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

    <!-- Product Template Tree View -->
    <record id="view_product_template_tree_multicompany" model="ir.ui.view">
        <field name="name">product.template.tree.multicompany</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="optional">show</attribute>
            </field>
            <field name="company_id" position="after">
                <field name="company_ids" widget="many2many_tags" optional="show" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

    <!-- Product Product Form View -->
    <record id="view_product_variant_easy_edit_view_multicompany" model="ir.ui.view">
        <field name="name">product.variant.easy.edit.multicompany</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="groups">base.group_multi_company</attribute>
            </field>
            <field name="company_id" position="after">
                <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

    <!-- Product Product Tree View -->
    <record id="view_product_product_tree_multicompany" model="ir.ui.view">
        <field name="name">product.product.tree.multicompany</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="optional">show</attribute>
            </field>
            <field name="company_id" position="after">
                <field name="company_ids" widget="many2many_tags" optional="show" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

</odoo>
