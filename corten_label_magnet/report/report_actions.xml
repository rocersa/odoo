<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        One action per label length. Bound to storage locations so
        Inventory -> Locations -> Print offers them; the product Print Labels
        wizard picks between them by format. The image action is chosen by the
        wizard for products; its artwork is 120 mm along the strip.
    -->
    <record id="action_corten_label_location" model="ir.actions.report">
        <field name="name">Magnet Label (72 x 70 mm)</field>
        <field name="model">stock.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">corten_label_magnet.report_label</field>
        <field name="report_file">corten_label_magnet.report_label</field>
        <field name="paperformat_id" ref="paperformat_corten_label"/>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Magnet Label'</field>
    </record>

    <record id="action_corten_label_location_image" model="ir.actions.report">
        <field name="name">Magnet Label with image (72 x 120 mm)</field>
        <field name="model">stock.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">corten_label_magnet.report_label_image</field>
        <field name="report_file">corten_label_magnet.report_label_image</field>
        <field name="paperformat_id" ref="paperformat_corten_label_image"/>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Magnet Label with image'</field>
    </record>

    <record id="action_corten_label_location_100" model="ir.actions.report">
        <field name="name">Magnet Label 100 mm (72 x 100 mm)</field>
        <field name="model">stock.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">corten_label_magnet.report_label_100</field>
        <field name="report_file">corten_label_magnet.report_label_100</field>
        <field name="paperformat_id" ref="paperformat_corten_label_100"/>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Magnet Label 100 mm'</field>
    </record>
</odoo>
