<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_corten_label_template" model="ir.actions.report">
        <field name="name">Magnet Label</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">corten_label_magnet.report_label</field>
        <field name="report_file">corten_label_magnet.report_label</field>
        <field name="paperformat_id" ref="paperformat_corten_label"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Magnet Label - %s' % (object.name)</field>
    </record>

    <record id="action_corten_label_product" model="ir.actions.report">
        <field name="name">Magnet Label</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">corten_label_magnet.report_label</field>
        <field name="report_file">corten_label_magnet.report_label</field>
        <field name="paperformat_id" ref="paperformat_corten_label"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Magnet Label - %s' % (object.display_name)</field>
    </record>

    <record id="action_corten_label_location" model="ir.actions.report">
        <field name="name">Magnet Label</field>
        <field name="model">stock.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">corten_label_magnet.report_label</field>
        <field name="report_file">corten_label_magnet.report_label</field>
        <field name="paperformat_id" ref="paperformat_corten_label"/>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Magnet Label - %s' % (object.complete_name or object.name)</field>
    </record>
</odoo>
