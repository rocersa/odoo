<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        One page per copy. The PNG is already in the paper's orientation
        (72 mm across the roll, the along-strip length is the feed), so the
        page holds it at true size with no margins and no header.

        page_h comes from the report model: 70 for the standard label, 100 for
        the wide one. The block is half a millimetre under the page so it
        cannot round onto a blank second page.
    -->
    <template id="label_pages">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="n" t-value="(copies or {}).get(o.id, 1) or 1"/>
                <t t-foreach="[o] * n" t-as="cell">
                    <div class="article"
                         t-att-data-oe-model="cell._name"
                         t-att-data-oe-id="cell.id"
                         t-att-data-oe-lang="cell.env.context.get('lang')">
                        <style>
                            html, body, main, #wrapwrap { margin: 0 !important; padding: 0 !important; max-width: none !important; }
                            body.container, body.o_body_pdf { margin: 0 !important; padding: 0 !important; max-width: none !important; }
                            .article { margin: 0 !important; padding: 0 !important; border: 0 !important; background: none !important; }
                            .corten-label-page { width: 71.5mm; padding: 0; overflow: hidden; }
                            .corten-label-page img { width: 71.5mm; height: 100%; display: block; }
                        </style>
                        <div class="corten-label-page"
                             t-attf-style="height:{{ page_h - 0.5 }}mm;">
                            <img t-if="labels.get(cell.id)"
                                 t-att-src="image_data_uri(labels[cell.id])"
                                 alt="Magnet label"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_label">
        <t t-call="corten_label_magnet.label_pages"/>
    </template>

    <template id="report_label_100">
        <t t-call="corten_label_magnet.label_pages"/>
    </template>
</odoo>
