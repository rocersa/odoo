<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        One page per copy. The PNG is already in the paper's orientation
        (72 mm across the roll, 70 mm along the feed), so the page holds it at
        true size with no margins and no header.

        The styles neutralise the report layout's container padding: the page
        is the label, not a document on a page.
    -->
    <template id="report_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="n" t-value="(copies or {}).get(o.id, 1) or 1"/>
                <t t-foreach="[o] * n" t-as="cell">
                    <div class="article"
                         t-att-data-oe-model="cell._name"
                         t-att-data-oe-id="cell.id"
                         t-att-data-oe-lang="cell.env.context.get('lang')">
                        <style>
                            html, body, main, #wrapwrap { margin: 0 !important; padding: 0 !important; max-width: none !important; }
                            body.container, body.o_body_pdf { margin: 0 !important; padding: 0 !important; max-width: none !important; }
                            .article { margin: 0 !important; padding: 0 !important; border: 0 !important; background: none !important; }
                            /* Keep the block half a millimetre under the page: an
                               exact-height block rounds one device pixel over in
                               wkhtmltopdf and spills a blank second page. */
                            .corten-label-page { width: 71.5mm; height: 69.5mm; padding: 0; overflow: hidden; }
                            .corten-label-page img { width: 71.5mm; height: 69.5mm; display: block; }
                        </style>
                        <div class="corten-label-page">
                            <img t-if="cell.corten_label_png"
                                 t-att-src="image_data_uri(cell.corten_label_png)"
                                 alt="Magnet label"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
