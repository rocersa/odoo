<odoo>
    <template id="eg_website_quote_template" name="Quote  Request">
        <t t-call="website.layout">
            <t t-set="show_shorter_cart_summary" t-value="True"/>
            <t t-set="show_footer" t-value="True"/>
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8">
                        <div class="card shadow-lg rounded-lg">
                            <div class="card-body text-center">
                                <h2 class="card-title text-success mb-4">Thank You!</h2>

                                <p class="text-center lead">
                                    We are processing your delivery quote request. Our team will analyse your request and get back to you with a
                                    comprehensive quote within 4-6 business hours.
                                </p>
                                <br/>
                                <br/>
                                <p class="text-center lead">
                                    Your reference number is
                                    <t t-out="order.name"/>
                                </p>
                                <div class="text-center mt-4">
                                    <a href="/shop" class="btn btn-primary btn-lg mx-2">Continue Shop</a>
                                    <a href="/my/orders" class="btn btn-secondary btn-lg mx-2" title="confirmed orders">My orders</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template for logged-in users who need to provide address -->
    <template id="quote_address_needed" name="Quote Address Form">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-lg">
                            <div class="card-body">
                                <h3 class="card-title mb-4">Complete Your Address</h3>
                                <p class="text-muted mb-4">
                                    To provide an accurate delivery quote, we need your complete delivery address.
                                </p>
                                
                                <form method="post" action="/shop/get/quote" class="address_autoformat">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="guest_name" t-att-value="partner.name"/>
                                    <input type="hidden" name="guest_email" t-att-value="partner.email"/>
                                    
                                    <h6 class="mb-3">Delivery Address <span class="text-danger">*</span></h6>
                                    
                                    <div class="mb-3">
                                        <label for="street" class="form-label">Street Address <span class="text-danger">*</span></label>
                                        <input type="text" 
                                               class="form-control" 
                                               id="street" 
                                               name="street" 
                                               required="required" 
                                               t-att-value="partner.street or ''"
                                               placeholder="123 Main St"
                                               t-att-data-autocomplete-enabled="1 if website.has_google_places_api_key() else 0"/>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                                            <input type="text" 
                                                   class="form-control" 
                                                   id="city" 
                                                   name="city" 
                                                   required="required" 
                                                   t-att-value="partner.city or ''"
                                                   placeholder="City"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="zip" class="form-label">Postcode <span class="text-danger">*</span></label>
                                            <input type="text" 
                                                   class="form-control" 
                                                   id="zip" 
                                                   name="zip" 
                                                   required="required" 
                                                   t-att-value="partner.zip or ''"
                                                   placeholder="1234"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="state_id" class="form-label">State/Territory</label>
                                            <select class="form-control" id="state_id" name="state_id">
                                                <option value="">State/Territory</option>
                                                <t t-set="current_country" t-value="partner.country_id or request.env.ref('base.au')"/>
                                                <t t-foreach="request.env['res.country.state'].sudo().search([('country_id', '=', current_country.id)])" t-as="state">
                                                    <option t-att-value="state.id" t-att-selected="'selected' if partner.state_id.id == state.id else None">
                                                        <t t-out="state.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="country_id" class="form-label">Country <span class="text-danger">*</span></label>
                                            <select class="form-control" id="country_id" name="country_id" required="required">
                                                <option value="">Select a country...</option>
                                                <t t-foreach="request.env['res.country'].sudo().search([])" t-as="country">
                                                    <option t-att-value="country.id" 
                                                            t-att-data-code="country.code" 
                                                            t-att-selected="'selected' if (partner.country_id and partner.country_id.id == country.id) or (not partner.country_id and country.code == 'AU') else None">
                                                        <t t-out="country.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="guest_phone" class="form-label">Phone</label>
                                        <input type="tel" 
                                               class="form-control" 
                                               id="guest_phone" 
                                               name="guest_phone" 
                                               t-att-value="partner.phone or ''"
                                               placeholder="(555) 123-4567"/>
                                    </div>
                                    
                                    <h6 class="mb-3 mt-4">Additional Information</h6>
                                    <div class="mb-3">
                                        <label for="guest_message" class="form-label">Message (Optional)</label>
                                        <textarea class="form-control" 
                                                  id="guest_message" 
                                                  name="guest_message" 
                                                  rows="3" 
                                                  placeholder="Any special requirements or questions..."/>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/shop/cart" class="btn btn-secondary">Back to Cart</a>
                                        <button type="submit" class="btn btn-primary">Submit Quote Request</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>