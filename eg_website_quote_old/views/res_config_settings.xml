<odoo>
    <record id="res_config_setting_eg_is_disable_checkout" model="ir.ui.view">
        <field name="name">res.config.setting.eg.is.disable.checkout</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='checkout_registration_setting']" position="after">
                <setting id="eg_is_disable_checkout_settings" string="Disable Checkout" help="Disable Proceed to Checkout in the cart page of the website">
                    <field name="is_disable_checkout"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>