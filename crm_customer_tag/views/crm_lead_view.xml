<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the CRM Lead Form View -->
    <record id="crm_lead_view_form_inherit_customer_tag" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.customer.tag</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 20 merges the old lead/opportunity sections into one
                 group holding user_id, date_deadline, priority and tag_ids.
                 There is one tag_ids now, so one anchor covers both. -->
            <xpath
                expr="//group[field[@name='user_id'] and field[@name='tag_ids']]/field[@name='tag_ids']"
                position="attributes"
            >
                <attribute name="string">Opportunity Type</attribute>
            </xpath>

            <!-- Add Customer Type field after tag_ids -->
            <xpath
                expr="//group[field[@name='user_id'] and field[@name='tag_ids']]/field[@name='tag_ids']"
                position="after"
            >
                <field
                    name="category_id"
                    string="Customer Type"
                    widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create_edit': True}"
                    readonly="not partner_id"
                />
            </xpath>
        </field>
    </record>

    <!-- Inherit the CRM Lead Kanban View -->
    <record
        id="crm_case_kanban_view_leads_inherit_customer_tag"
        model="ir.ui.view"
    >
        <field name="name">crm.lead.kanban.lead.inherit.customer.tag</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Add Customer Type field after tag_ids in kanban view -->
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field
                    name="category_id"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
