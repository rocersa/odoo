<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Brand pick list for stock.report_picking (the "Picking Operations"
        report), used by **internal transfers and outgoing deliveries**. The
        same template also prints receipts, which keep the stock layout, so
        every change here is guarded on ``o.picking_type_id.code != 'incoming'``.

        The pick list is printed **one line per product**, not one per kit:
        components shared by several kits are amalgamated (quantity and weight
        summed) by ``stock.picking._brand_amalgamated_lines``. Columns are
        Code | Product | Weight | Quantity.

        On an outgoing delivery the delivery address is moved to the top-left
        and enlarged, with the title moved to the right beside the barcode.

        Widths and the enlarged delivery address live in brand_report.css,
        scoped to the ``o_brand_pick`` class this template adds to the page.
    -->
    <template id="report_picking_brand_pick"
              inherit_id="stock.report_picking"
              name="Picking Operations — amalgamated product picklist">

        <!-- Tag the page so brand_report.css can scope its rules to the brand
             pick list. Static ``class`` is overwritten by ``t-attf-class``
             (QWeb adds dynamic attrs after static ones), so the base classes
             are repeated here. -->
        <xpath expr="//div[hasclass('o_report_stockpicking_operations')]" position="attributes">
            <attribute name="t-attf-class">page o_report_stockpicking_operations{{ ' o_brand_pick' if o.picking_type_id.code != 'incoming' else '' }}</attribute>
        </xpath>

        <!-- Outgoing deliveries: put the delivery address in the top-left (where
             the title sits) and move the title to the right, with the barcode.
             Internal transfers and receipts keep the title top-left. -->
        <xpath expr="//div[h3[@t-field='o.picking_type_id.code']]" position="replace">
            <t t-if="o.picking_type_id.code == 'outgoing'">
                <div class="col" name="div_pick_address">
                    <div t-if="o.should_print_delivery_address()">
                        <strong>Delivery Address:</strong>
                        <t t-set="dest" t-value="o.move_ids[0].partner_id or o.partner_id"/>
                        <t t-set="dest_company" t-value="dest.commercial_company_name or dest.parent_id.name"/>
                        <!-- Odoo's contact widget folds the partner and its
                             company into one line ("Company, Person"). Print
                             the name, then the company, then the address. -->
                        <div class="o_pick_address_body">
                            <div t-out="dest.name"/>
                            <div t-if="dest_company and dest_company != dest.name" t-out="dest_company"/>
                            <div t-out="dest" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="col-4">
                    <h3 t-field="o.picking_type_id.code"/>
                    <h2 t-field="o.name">WH/OUT/00001</h2>
                </div>
            </t>
        </xpath>
        <!-- Right column: left-aligned, and for outgoing sized to its content
             (the title, not col-8) so the delivery address gets the rest. -->
        <xpath expr="//div[@name='right_box']" position="attributes">
            <attribute name="t-attf-class">{{ 'col-auto text-nowrap' if o.picking_type_id.code == 'outgoing' else 'col-8' }}</attribute>
        </xpath>
        <xpath expr="//div[@name='right_box']/div[@t-field='o.name']" position="before">
            <div t-if="o.picking_type_id.code == 'outgoing'">
                <h3 t-field="o.picking_type_id.code"/>
                <h2 t-field="o.name">WH/OUT/00001</h2>
            </div>
        </xpath>
        <!-- The delivery address now sits top-left: drop the row-2 copy. -->
        <xpath expr="//div[@name='div_outgoing_address']" position="replace"/>
        <!-- The Customer Address block only repeats the partner, which the
             delivery address already shows: drop it. -->
        <xpath expr="//div[@name='div_customer_address']" position="replace"/>

        <!-- Header: Code before Product, Weight before Quantity
             (internal + outgoing), giving Code | Product | Weight | Quantity. -->
        <xpath expr="//th[@name='th_product']" position="before">
            <th name="th_product_code" class="text-start" t-if="o.picking_type_id.code != 'incoming'">
                <strong>Code</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th name="th_weight" class="text-end" t-if="o.picking_type_id.code != 'incoming'">
                <strong>Weight</strong>
            </th>
        </xpath>

        <!-- Location columns: From is dropped on every picking type, To only
             remains on receipts. -->
        <xpath expr="//t[@t-set='from_col_exists']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='to_col_exists']" position="attributes">
            <attribute name="t-value">o.picking_type_id.code == 'incoming'</attribute>
        </xpath>

        <!-- Body: for the brand pick list, hide the stock per-move rows and
             print the amalgamated product lines instead. -->
        <xpath expr="//table[hasclass('o_main_table')]/tbody/t[@t-foreach]" position="attributes">
            <attribute name="t-if">o.picking_type_id.code == 'incoming'</attribute>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]/tbody/t[@t-foreach]" position="before">
            <t t-if="o.picking_type_id.code != 'incoming'">
                <tr t-foreach="o._brand_amalgamated_lines()" t-as="line">
                    <t t-set="product" t-value="line['product']"/>
                    <td class="text-start">
                        <span t-out="product.default_code"/>
                    </td>
                    <td class="text-start">
                        <span t-out="product.name"/>
                    </td>
                    <td class="text-end">
                        <span t-out="line['weight']" t-options="{'widget': 'float', 'precision': 2}"/>
                        <span t-out="product.weight_uom_name"/>
                    </td>
                    <td class="o_td_quantity text-end">
                        <span t-out="format_number(line['quantity'])" class="text-nowrap"/>
                    </td>
                    <td class="text-center" t-if="barcode_col_exists">
                        <span t-if="product.barcode">
                            <div t-field="product.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:35px;'}">
                                <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                    (product barcode)
                                </div>
                            </div>
                        </span>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>

    <!--
        stock_delivery adds a "Weight:" (o.shipping_weight) to the picking
        header row, shown at the field's own digits. Print it to 2dp so it
        matches the picklist's Weight column.
    -->
    <template id="report_picking_header_weight"
              inherit_id="stock_delivery.report_shipping2"
              name="Picking Operations — header weight to 2dp">
        <xpath expr="//span[@t-field='o.shipping_weight']" position="attributes">
            <attribute name="t-options">{'widget': 'float', 'precision': 2}</attribute>
        </xpath>
    </template>

    <!--
        The picking report renders no letterhead, so the default A4 top margin
        (52 mm) and bottom margin (32 mm) are blank. Use a paperformat with a
        normal print margin instead. Left/right stay at 0 here because
        css_margins=True supplies 11 mm of side padding via the report CSS —
        same as invoices and delivery slips.
    -->
    <record id="paperformat_picking_operations" model="report.paperformat">
        <field name="name">Picking Operations</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">11</field>
        <field name="margin_bottom">11</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_picking_operations"/>
    </record>
</odoo>
