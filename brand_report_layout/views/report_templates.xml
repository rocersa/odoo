<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Brand document layout (docs/brand/design-standard.md §9).

        Base = a local copy of Odoo 19's stock *striped* layout. Odoo 20 removed
        the template (not the styling: `o_table_striped` still exists), so the
        copy keeps the look the brand standard chose. The 19 layout's
        `layout_background` block is dropped because those res.company fields
        were removed in 20.

        Three brand changes live in `external_layout_striped_brand` below:
          1. company address right-aligned in the header (as in Bold);
          2. the stock standalone document-title heading is removed;
          3. customer address left, document number right on the same line
             (as in Bubble).
    -->
    <template id="external_layout_striped" name="Striped (Rocersa base)">
        <div t-attf-class="o_company_#{company.id}_layout header">
            <div class="d-flex">
                <div class="mw-50">
                    <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold mt-2">Company tagline</div>
                </div>
                <div class=" w-50 ms-3" name="company_address">
                    <ul class="list-unstyled" name="company_address_list">
                        <li t-if="company.is_company_details_empty">
                            <span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company address block</strong>
                                    <div>Contains the company address.</div>
                                </div>
                            </span>
                        </li>
                        <li t-else="">
                            <span t-field="company.company_details">
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company details block</strong>
                                    <div>Contains the company details.</div>
                                </div>
                            </span>
                        </li>
                        <li t-if="not forced_vat">
                            <t t-if="company.vat">
                                <t t-out="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-out="company.vat"/>
                            </t>
                        </li>
                        <li t-else="">
                            <t t-out="company.country_id.vat_label or 'Tax ID'"/>:
                            <span t-out="forced_vat"/>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div t-attf-class="o_company_#{company.id}_layout article o_report_layout_striped o_table_striped o_snail_mail"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <h2 t-out="layout_document_title"/>
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content border-top pt-2 text-center">
                <div t-field="company.report_footer"/>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted" t-out="o.name">(document name)</div>
                <div t-if="report_type == 'pdf'" class="text-muted">Page <span class="page"/> / <span class="topage"/></div>
            </div>
        </div>
    </template>

    <template id="external_layout_striped_brand"
              inherit_id="brand_report_layout.external_layout_striped"
              name="Striped — Rocersa brand">

        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="class" add="text-end" separator=" "/>
        </xpath>

        <xpath expr="//h2[@t-out='layout_document_title' and not(ancestor::td)]" position="replace"/>

        <xpath expr="//t[@t-call='web.address_layout']" position="replace">
            <table class="o_ignore_layout_styling table table-borderless mb-0">
                <tbody>
                    <tr>
                        <td t-attf-class="p-0 {{'pt-3' if information_block else ''}}">
                            <!-- custom_layout_address drops address_layout's
                                 default `col-5 ms-auto` (which pushes the block
                                 right and cramps it) so it fills the cell. -->
                            <t t-call="web.address_layout" custom_layout_address="true"/>
                        </td>
                        <td t-if="not information_block" class="align-bottom p-0 ps-2">
                            <h2 class="mb-4 text-nowrap text-end" t-out="layout_document_title"/>
                        </td>
                    </tr>
                    <tr t-if="information_block">
                        <td colspan="2" class="align-bottom p-0">
                            <h2 class="text-nowrap text-end" t-out="layout_document_title"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
