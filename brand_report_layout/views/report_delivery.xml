<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Delivery slip: split the single Product cell into a **Code** column and
        a **product-name** column. Odoo prints the product display name, which
        reads "[CODE] Name", in one cell; this separates them.

        Covers both the pre-validation table (stock_move_table) and the
        post-validation aggregated / serial rows (stock sub-templates).
    -->
    <template id="report_delivery_document_code"
              inherit_id="stock.report_delivery_document"
              name="Delivery slip — product code column">

        <!-- Done table header -->
        <xpath expr="//table[@name='stock_move_line_table']//thead/tr/th[@name='th_sml_product']" position="before">
            <th name="th_sml_code">Code</th>
        </xpath>

        <!-- Pre-validation table header -->
        <xpath expr="//table[@name='stock_move_table']//thead/tr/th[@name='th_sm_product']" position="before">
            <th name="th_sm_code"><strong>Code</strong></th>
        </xpath>

        <!-- Pre-validation table row -->
        <xpath expr="//table[@name='stock_move_table']//tbody/tr/td[1]" position="replace">
            <td><span t-field="move.product_id.default_code"/></td>
            <td>
                <span t-field="move.product_id.name"/>
                <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                    <span t-out="move.description_picking" t-options="{'widget': 'text'}"/>
                </p>
            </td>
        </xpath>
    </template>

    <!-- Post-validation aggregated rows -->
    <template id="report_delivery_aggregated_code"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines"
              name="Delivery slip — aggregated code column">
        <xpath expr="//tr/td[1]" position="replace">
            <td>
                <t t-set="full_name" t-value="aggregated_lines[line]['name'] or ''"/>
                <t t-set="rb" t-value="full_name.find(']')"/>
                <span t-out="full_name[1:rb] if full_name.startswith('[') and rb &gt; 0 else ''"/>
            </td>
            <td>
                <span t-out="full_name[rb+1:].strip() if full_name.startswith('[') and rb &gt; 0 else full_name"/>
                <p t-if="aggregated_lines[line]['description']">
                    <span t-esc="aggregated_lines[line]['description']" t-options="{'widget': 'text'}"/>
                </p>
            </td>
        </xpath>
    </template>

    <!-- Post-validation serial / lot rows -->
    <template id="report_delivery_serial_code"
              inherit_id="stock.stock_report_delivery_has_serial_move_line"
              name="Delivery slip — serial code column">
        <xpath expr="//td[1]" position="replace">
            <td><span t-field="move_line.product_id.default_code"/></td>
            <td>
                <span t-field="move_line.product_id.name"/>
                <t t-if="not description and description != ''">
                    <t t-set="description" t-value="move_line.move_id.description_picking"/>
                </t>
                <p t-if="description != '' and description != move_line.product_id.display_name and description != move_line.product_id.name">
                    <span t-out="description" t-options="{'widget': 'text'}"/>
                </p>
            </td>
        </xpath>
    </template>
</odoo>
