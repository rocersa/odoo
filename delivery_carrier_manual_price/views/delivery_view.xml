<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form - delivery_carrier_manual_price</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <field name="integration_level" position="before">
                <field name="is_manual_price" />
            </field>
        </field>
    </record>
    <record id="view_order_form_with_carrier" model="ir.ui.view">
        <field name="name">sale.order.form - delivery_carrier_manual_price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="delivery.view_order_form_with_carrier" />
        <field name="arch" type="xml">
            <!-- Odoo 20 adds a second "Shipping" button, so the old positional
                 [2]/[3] targets are wrong, and `string` is forbidden as a
                 selector (translated attribute). Both "Update shipping cost"
                 buttons are the only action_open_delivery_wizard buttons with
                 a context; target those. -->
            <xpath
                expr="(//button[@name='action_open_delivery_wizard'][@context])[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="(//button[@name='action_open_delivery_wizard'][@context])[2]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
