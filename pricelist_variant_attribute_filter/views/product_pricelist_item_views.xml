<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_pricelist_item_form_view" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.area.filter</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <!-- Hide the single-variant selector; area filter replaces it -->
            <field name="product_id" position="replace">
                <field name="product_id"
                    options="{'no_create': 1}"
                    invisible="1"/>
            </field>

            <!-- Add custom name and area filter after the product template -->
            <field name="product_tmpl_id" position="after">
                <field name="custom_name"
                    placeholder="Auto-generated if empty"/>
                <label for="min_area" string="Area Filter (mm²)"
                    invisible="display_applied_on != '1_product' or not product_tmpl_id or product_variant_count &lt; 2"/>
                <div class="o_row"
                    invisible="display_applied_on != '1_product' or not product_tmpl_id or product_variant_count &lt; 2">
                    <field name="min_area" placeholder="Min"/>
                    <span class="mx-1">—</span>
                    <field name="max_area" placeholder="Max"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
