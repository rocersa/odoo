<odoo>
    <!-- Modal form for guest users to submit quote request -->
    <template id="guest_quote_form_modal" name="Guest Quote Request Form">
        <div class="modal fade" id="guestQuoteModal" tabindex="-1" aria-labelledby="guestQuoteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form id="guest_quote_form" action="/shop/get/quote/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-header">
                            <h5 class="modal-title" id="guestQuoteModalLabel">Request a Quote</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted mb-4">Please provide your contact information to receive a quote.</p>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="guest_name" class="form-label">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="guest_name" name="name" required="required"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_email" class="form-label">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" id="guest_email" name="email" required="required"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_phone" class="form-label">Phone</label>
                                    <input type="tel" class="form-control" id="guest_phone" name="phone"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_company" class="form-label">Company</label>
                                    <input type="text" class="form-control" id="guest_company" name="company_name"/>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="guest_street" class="form-label">Street Address <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control o_address_autocomplete" id="guest_street" name="street" required="required" autocomplete="off"/>
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="guest_street2" class="form-label">Street 2</label>
                                    <input type="text" class="form-control" id="guest_street2" name="street2"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_city" class="form-label">City <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="guest_city" name="city" required="required"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_zip" class="form-label">Zip/Postal Code <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="guest_zip" name="zip" required="required"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_country" class="form-label">Country <span class="text-danger">*</span></label>
                                    <select class="form-select" id="guest_country" name="country_id" required="required">
                                        <option value="">Select a country...</option>
                                        <t t-foreach="request.env['res.country'].sudo().search([])" t-as="country">
                                            <option t-att-value="country.id" t-out="country.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="guest_state" class="form-label">State/Province</label>
                                    <select class="form-select" id="guest_state" name="state_id">
                                        <option value="">Select a state...</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit Quote Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>

    <!-- Inject the modal into the navigation buttons (where the Get Quote button is) -->
    <template id="website_quote_cart_modal" inherit_id="eg_website_quote.website_sale_navigation_buttons_quote">
        <xpath expr="//a[@id='get_quote_btn']" position="after">
            <t t-call="eg_website_quote.guest_quote_form_modal"/>
        </xpath>
    </template>
</odoo>
