<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default system parameters -->
    <record id="default_sip_header_name" model="ir.config_parameter">
        <field name="key">voip_caller_identity.sip_header_name</field>
        <field name="value">X-Outbound-CallerID</field>
    </record>
    <record id="default_sip_header_format" model="ir.config_parameter">
        <field name="key">voip_caller_identity.sip_header_format</field>
        <field name="value">number_only</field>
    </record>
    <record id="default_fallback_behaviour" model="ir.config_parameter">
        <field name="key">voip_caller_identity.fallback_behaviour</field>
        <field name="value">user_default</field>
    </record>
    <record id="default_invalid_identity_action" model="ir.config_parameter">
        <field name="key">voip_caller_identity.invalid_identity_action</field>
        <field name="value">fallback</field>
    </record>
</odoo>
