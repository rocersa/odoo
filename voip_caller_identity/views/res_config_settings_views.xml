<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_voip_caller_identity" model="ir.ui.view">
        <field name="name">res.config.settings.form.voip.caller.identity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app notApp="1" string="Phone" data-string="Phone" name="voip" groups="base.group_system">
                    <block title="Outbound Caller Identity" name="voip_caller_identity_settings">
                        <setting help="Custom SIP header name sent to FreePBX with the caller identity">
                            <field name="voip_sip_header_name"/>
                        </setting>
                        <setting help="Format of the value included in the SIP header">
                            <field name="voip_sip_header_format"/>
                        </setting>
                        <setting help="What happens when the user has not selected a caller identity">
                            <field name="voip_identity_fallback"/>
                        </setting>
                        <setting help="What happens when the selected identity is invalid or not allowed">
                            <field name="voip_invalid_identity_action"/>
                        </setting>
                        <setting help="System-wide fallback identity when no user or team default is set">
                            <field name="voip_system_default_identity_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
