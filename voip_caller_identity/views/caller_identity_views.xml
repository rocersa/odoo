<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Caller Identity Form View -->
    <record id="voip_caller_identity_view_form" model="ir.ui.view">
        <field name="name">voip.caller.identity.form</field>
        <field name="model">voip.caller.identity</field>
        <field name="arch" type="xml">
            <form string="Caller Identity">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. AU Sales"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone_number" placeholder="+61291234567"/>
                            <field name="country_id"/>
                            <field name="business_unit"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allowed Users" name="users">
                            <field name="user_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Allowed Teams" name="teams">
                            <field name="team_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes about this identity..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Caller Identity List View -->
    <record id="voip_caller_identity_view_list" model="ir.ui.view">
        <field name="name">voip.caller.identity.list</field>
        <field name="model">voip.caller.identity</field>
        <field name="arch" type="xml">
            <list string="Caller Identities">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="country_id"/>
                <field name="business_unit"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="team_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Caller Identity Search View -->
    <record id="voip_caller_identity_view_search" model="ir.ui.view">
        <field name="name">voip.caller.identity.search</field>
        <field name="model">voip.caller.identity</field>
        <field name="arch" type="xml">
            <search string="Search Caller Identities">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="business_unit"/>
                <field name="country_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="Business Unit" name="group_business_unit" context="{'group_by': 'business_unit'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="voip_caller_identity_action" model="ir.actions.act_window">
        <field name="name">Caller Identities</field>
        <field name="res_model">voip.caller.identity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="voip_caller_identity_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first outbound caller identity
            </p>
            <p>
                Define phone numbers (DIDs) that users can select as their
                outbound caller ID when making VoIP calls.
            </p>
        </field>
    </record>

    <!-- Menu items under Phone/Configuration -->
    <menuitem id="menu_voip_caller_identity_config"
              name="Caller Identities"
              parent="voip.menu_voip_config"
              action="voip_caller_identity_action"
              sequence="20"
              groups="group_voip_caller_identity_manager"/>
</odoo>
