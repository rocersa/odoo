<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Inject the CallerIdentityDropdown into the Odoo VoIP Dialer component.
        In Odoo 19 the dialer template is voip.Dialer.
    -->

    <t t-name="voip_caller_identity.DialerExtension" t-inherit="voip.Dialer" t-inherit-mode="extension" owl="1">
        <xpath expr="//Keypad" position="before">
            <CallerIdentityDropdown compact="true"/>
        </xpath>
    </t>

</templates>
