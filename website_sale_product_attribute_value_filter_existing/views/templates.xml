<odoo>
    <!-- Inherit the select filter template -->
    <template id="filter_select_attributes" inherit_id="website_sale.filter_select_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
    </template>

    <!-- Inherit the radio and multi filter template -->
    <template id="filter_radio_and_multi_attributes" inherit_id="website_sale.filter_radio_and_multi_attributes">
        <xpath expr="//div[@t-foreach='sorted_values[:8]']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
        <xpath expr="//div[@t-foreach='sorted_values[8:]']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='sorted_values']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
    </template>

    <!-- Inherit the pills filter template -->
    <template id="filter_pills_attributes" inherit_id="website_sale.filter_pills_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
    </template>

    <!-- Inherit the color filter template -->
    <template id="filter_color_attributes" inherit_id="website_sale.filter_color_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
    </template>

    <!-- Inherit the image filter template -->
    <template id="filter_image_attributes" inherit_id="website_sale.filter_image_attributes">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-if">not attr_values_used_ids or v.id in attr_values_used_ids</attribute>
        </xpath>
    </template>
</odoo>
