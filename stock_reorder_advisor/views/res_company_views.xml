<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_company_form_reorder_advisor" model="ir.ui.view">
        <field name="name">res.company.form.reorder.advisor</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Reorder Advisor" name="reorder_advisor">
                    <group>
                        <group string="Defaults">
                            <field name="reorder_default_service_level"/>
                            <field name="reorder_analysis_days"/>
                            <field name="reorder_slow_mover_threshold"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
