<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form view: add Reorder Advisor section -->
    <record id="stock_warehouse_orderpoint_view_form_advisor" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.advisor</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <group string="Reorder Advisor">
                    <group>
                        <field name="analysis_days"/>
                        <field name="service_level_pct"/>
                    </group>
                    <group>
                        <field name="demand_pattern" readonly="1"/>
                        <field name="stockout_risk_score" readonly="1"/>
                    </group>

                    <!-- Contextual info boxes -->
                    <div class="alert alert-info" role="alert"
                         invisible="demand_pattern != 'intermittent'">
                        <strong>Intermittent demand detected.</strong>
                        Average gap between orders is
                        <field name="avg_order_interval_days" class="oe_inline"/> days.
                        Consider a periodic review rather than reacting to every sale.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="demand_pattern != 'lumpy'">
                        <strong>Lumpy demand detected.</strong>
                        Order sizes vary widely; ensure Min Qty can absorb one large order
                        (max historical size: <field name="max_order_size" class="oe_inline"/>).
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="stockout_risk_score not in ('high', 'critical')">
                        <strong>High stockout risk.</strong>
                        Current Min Qty (<field name="product_min_qty" class="oe_inline"/>)
                        is below the suggested Min Qty
                        (<field name="suggested_min_qty" class="oe_inline"/>).
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="coverage_days &lt;= 365">
                        <strong>Excess coverage.</strong>
                        More than one year of supply on hand. Consider reducing Max Qty.
                    </div>

                    <field name="advisor_message" nolabel="1" readonly="1"/>
                </group>

                <group string="Demand Statistics">
                    <group>
                        <field name="annual_demand_units" readonly="1"/>
                        <field name="avg_order_size" readonly="1"/>
                        <field name="max_order_size" readonly="1"/>
                        <field name="last_sale_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="avg_order_interval_days" readonly="1"/>
                        <field name="std_order_size" readonly="1"/>
                        <field name="lead_time_demand" readonly="1"/>
                        <field name="lead_time_demand_std" readonly="1"/>
                    </group>
                </group>

                <group string="Suggestions">
                    <group>
                        <field name="suggested_safety_stock" readonly="1"/>
                        <field name="suggested_min_qty" readonly="1"/>
                        <field name="suggested_max_qty" readonly="1"/>
                        <field name="suggested_order_qty" readonly="1"/>
                    </group>
                    <group>
                        <field name="coverage_days" readonly="1"/>
                        <field name="lead_days" readonly="1"/>
                    </group>
                </group>

                <div class="oe_button_box" name="button_box">
                    <button name="action_apply_suggested_min_max" type="object"
                            string="Apply Suggested Min/Max" class="btn-primary"/>
                    <button name="action_recompute_advisor" type="object"
                            string="Recompute Advisor" class="btn-secondary"/>
                </div>
            </sheet>
        </field>
    </record>

    <!-- List view: add key advisor columns -->
    <record id="stock_warehouse_orderpoint_view_tree_advisor" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.advisor</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree"/>
        <field name="arch" type="xml">
            <field name="product_max_qty" position="after">
                <field name="demand_pattern" optional="show"/>
                <field name="stockout_risk_score" optional="show"
                       decoration-danger="stockout_risk_score == 'critical'"
                       decoration-warning="stockout_risk_score == 'high'"
                       decoration-success="stockout_risk_score == 'low'"/>
                <field name="suggested_min_qty" optional="hide"/>
                <field name="suggested_max_qty" optional="hide"/>
                <field name="coverage_days" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Search view: filters for planners -->
    <record id="stock_warehouse_orderpoint_view_search_advisor" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.search.advisor</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="High/Critical Stockout Risk" name="high_stockout_risk"
                        domain="[('stockout_risk_score', 'in', ('high', 'critical'))]"/>
                <filter string="Lumpy or Intermittent" name="lumpy_intermittent"
                        domain="[('demand_pattern', 'in', ('lumpy', 'intermittent'))]"/>
                <filter string="Excess Coverage (&gt;1 year)" name="excess_coverage"
                        domain="[('coverage_days', '&gt;', 365)]"/>
                <filter string="Slow Movers" name="slow_movers"
                        domain="[('annual_demand_units', '&lt;', 20)]"/>
                <group expand="0" string="Group By">
                    <filter string="Demand Pattern" name="group_demand_pattern"
                            context="{'group_by': 'demand_pattern'}"/>
                    <filter string="Stockout Risk" name="group_stockout_risk"
                            context="{'group_by': 'stockout_risk_score'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Server action: bulk apply suggestions -->
    <record id="action_apply_suggested_min_max_server" model="ir.actions.server">
        <field name="name">Apply Suggested Min/Max</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_apply_suggested_min_max()
        </field>
    </record>

</odoo>
