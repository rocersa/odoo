<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']"
                position="before"
            >
                <button
                    name="action_sort_lines_by_product"
                    type="object"
                    string="Sort Lines by Product"
                    invisible="not order_line"
                    class="btn btn-secondary mb-2"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list//field[@name='price_unit']"
                position="before"
            >
                <field name="line_weight" digits="[16, 0]" />
            </xpath>
            <xpath
                expr="//field[@name='tax_totals']"
                position="before"
            >
                 <div class="row">
                        <div class="col-5 text-end" style="white-space: nowrap;">
                            <strong>Total Weight:</strong>
                        </div>
                        <div class="col-5 text-end" style="white-space: nowrap;">
                            <field name="total_weight" widget="float" digits="[16, 0]" /> kg
                        </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
