<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.website.quote</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='automatic_invoice_generation_setting']" position="after">
                <setting id="rocersa_quote_mode_setting"
                         help="Hide checkout and replace it with a quote-request button on this website's cart.">
                    <field name="is_disable_checkout"/>
                </setting>
                <setting id="rocersa_quote_lead_setting"
                         help="Create the shared Supabase lead for each quote request. The Odoo order remains the fulfilment record.">
                    <field name="website_quote_lead_enabled"/>
                </setting>
                <setting id="rocersa_quote_lead_connection"
                         invisible="not website_quote_lead_enabled"
                         help="Connection for the shared Supabase leads table. The service key comes from the SUPABASE_SERVICE_KEY environment variable.">
                    <field name="website_quote_supabase_url" placeholder="https://xxxx.supabase.co"/>
                    <field name="website_quote_subdivision_id"/>
                </setting>
                <setting id="rocersa_quote_posthog_setting"
                         help="Send quote_request_submitted to PostHog using the website's project key and host (configure them in the PostHog settings).">
                    <field name="website_quote_posthog_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
