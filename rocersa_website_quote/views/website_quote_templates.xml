<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Cart CTA for websites in quote mode: hide the checkout button and offer
        a quote request in its place. Guests get the modal form; logged-in
        customers go straight to the RFQ endpoint.
    -->
    <template id="website_sale_navigation_buttons_quote"
              inherit_id="website_sale.navigation_buttons">
        <xpath expr="//a[@name='website_sale_main_button']" position="attributes">
            <attribute name="t-if">not website.is_disable_checkout</attribute>
        </xpath>
        <xpath expr="//a[@name='website_sale_main_button']" position="after">
            <t t-if="website.is_disable_checkout">
                <a t-if="not request.env.user._is_public()"
                   role="button"
                   id="rocersa_get_quote_btn"
                   class="btn btn-primary w-100"
                   href="/shop/quote">
                    Get Delivery Quote
                    <i class="oi ms-2 fw-light" data-icon="keyboard_arrow_right"/>
                </a>
                <a t-else=""
                   role="button"
                   id="rocersa_get_quote_btn"
                   class="btn btn-primary w-100"
                   href="#rocersa_quote_modal"
                   data-bs-toggle="modal">
                    Get Delivery Quote
                    <i class="oi ms-2 fw-light" data-icon="keyboard_arrow_right"/>
                </a>
                <t t-if="request.env.user._is_public()"
                   t-call="rocersa_website_quote.guest_quote_modal"/>
            </t>
        </xpath>
    </template>

    <template id="guest_quote_modal" name="Guest Quote Request Modal">
        <t t-set="default_country_id" t-value="website.company_id.country_id.id"/>
        <div class="modal fade" id="rocersa_quote_modal" tabindex="-1"
             aria-labelledby="rocersa_quote_modal_label" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <form id="rocersa_quote_form" action="/shop/quote/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="utm_source" value=""/>
                        <input type="hidden" name="utm_medium" value=""/>
                        <input type="hidden" name="utm_campaign" value=""/>
                        <input type="hidden" name="landing_page" t-att-value="request.httprequest.url"/>
                        <div class="modal-header">
                            <h5 class="modal-title" id="rocersa_quote_modal_label">Request a Quote</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">Tell us where to deliver and we will send a freight quote.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_name">Full Name <span class="text-danger">*</span></label>
                                    <input class="form-control" id="rocersa_quote_name" name="name" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_email">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" id="rocersa_quote_email" name="email" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_phone">Phone</label>
                                    <input type="tel" class="form-control" id="rocersa_quote_phone" name="phone"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_company">Company</label>
                                    <input class="form-control" id="rocersa_quote_company" name="company_name"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="rocersa_quote_street">Street Address <span class="text-danger">*</span></label>
                                    <input class="form-control" id="rocersa_quote_street" name="street" required="required" autocomplete="street-address"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="rocersa_quote_street2">Street 2</label>
                                    <input class="form-control" id="rocersa_quote_street2" name="street2"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_city">City <span class="text-danger">*</span></label>
                                    <input class="form-control" id="rocersa_quote_city" name="city" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_zip">Postcode <span class="text-danger">*</span></label>
                                    <input class="form-control" id="rocersa_quote_zip" name="zip" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_country">Country <span class="text-danger">*</span></label>
                                    <select class="form-select" id="rocersa_quote_country" name="country_id" required="required">
                                        <option value="">Select a country...</option>
                                        <t t-foreach="request.env['res.country'].sudo().search([], order='name')" t-as="country">
                                            <option t-att-value="country.id"
                                                    t-att-selected="'selected' if country.id == default_country_id else None"
                                                    t-out="country.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="rocersa_quote_state">State / Province</label>
                                    <select class="form-select" id="rocersa_quote_state" name="state_id"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="rocersa_quote_message">Message</label>
                                    <textarea class="form-control" id="rocersa_quote_message" name="message" rows="3"/>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit Quote Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>

    <template id="quote_thank_you" name="Quote Request Received">
        <t t-call="website.layout">
            <t t-set="additional_title">Quote Request Received</t>
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8">
                        <div class="card shadow-sm">
                            <div class="card-body text-center">
                                <h1 class="h3 text-success mb-3">Thank you</h1>
                                <p class="lead">We have received your quote request and will send your freight quote shortly.</p>
                                <p>Your reference number is <strong t-out="order.name"/></p>
                                <div class="mt-4">
                                    <a class="btn btn-primary me-2" href="/shop">Continue shopping</a>
                                    <a class="btn btn-secondary" href="/my/orders">My orders</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="quote_error" name="Quote Request Error">
        <t t-call="website.layout">
            <t t-set="additional_title">Quote Request</t>
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8">
                        <div class="alert alert-danger" role="alert" t-out="error"/>
                        <a class="btn btn-primary" href="/shop/cart">Back to cart</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
