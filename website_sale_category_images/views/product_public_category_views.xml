<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_category_image_form" model="ir.ui.view">
        <field name="name">product.public.category.image.view.form</field>
        <field name="model">product.public.category.image</field>
        <field name="arch" type="xml">
            <form string="Category Images">
                <field name="sequence" invisible="1"/>
                <div class="row o_website_sale_image_modal">
                    <div class="col-md-6 col-xl-5">
                        <label for="name" string="Image Name"/>
                        <h2><field name="name" placeholder="Image Name"/></h2>
                    </div>
                    <div class="col-md-6 col-xl-7 text-center o_website_sale_image_modal_container">
                        <div class="row">
                            <div class="col">
                                <field name="image_1920" widget="image"/>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="category_image_view_kanban" model="ir.ui.view">
        <field name="name">product.public.category.image.view.kanban</field>
        <field name="model">product.public.category.image</field>
        <field name="arch" type="xml">
            <kanban string="Category Images" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <templates>
                    <t t-name="card" class="p-0 border-0">
                        <div class="card">
                            <div class="o_squared_image">
                                <field class="card-img-top" name="image_1920" widget="x2_many_image"/>
                            </div>
                            <div class="p-2 m-0 bg-200" t-attf-title="#{record.name.value}">
                                <field name="name" class="small fs-5 text-truncate d-block"/>
                            </div>
                            <t t-if="record.image_1920.raw_value.length &lt; 100*1000">
                                <t t-set="size_status" t-value="'text-bg-success'"/>
                                <t t-set="message">Acceptable file size</t>
                            </t>
                            <t t-elif="record.image_1920.raw_value.length &lt; 1000*1000">
                                <t t-set="size_status" t-value="'text-bg-warning'" />
                                <t t-set="message">Huge file size. The image should be optimized/reduced.</t>
                            </t>
                            <t t-else="1">
                                <t t-set="size_status" t-value="'text-bg-danger'"/>
                                <t t-set="message">Optimization required! Reduce the image size or increase your compression settings.</t>
                            </t>
                            <span t-attf-class="badge #{size_status} o_product_image_size" t-att-title="message"></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_public_category_form_view" model="ir.ui.view">
        <field name="name">product.public.category.form.inherit.category.images</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group colspan="2" name="category_images" string="eCommerce Media">
                    <field
                        colspan="2"
                        name="category_image_ids"
                        class="o_website_sale_image_list"
                        context="{'default_name': name}"
                        mode="kanban"
                        add-label="Add Media"
                        nolabel="1"
                        widget="x2_many_media_viewer"
                        options="{'convert_to_webp': True}"
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
