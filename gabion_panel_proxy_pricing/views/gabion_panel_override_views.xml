<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="gabion_panel_override_view_list" model="ir.ui.view">
        <field name="name">gabion.panel.override.list</field>
        <field name="model">gabion.panel.override</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="current_length"/>
                <field name="proxy_length"/>
            </list>
        </field>
    </record>

    <record id="gabion_panel_override_view_form" model="ir.ui.view">
        <field name="name">gabion.panel.override.form</field>
        <field name="model">gabion.panel.override</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="current_length"/>
                        <field name="proxy_length"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gabion_panel_override_action" model="ir.actions.act_window">
        <field name="name">Gabion Panel Proxy Lengths</field>
        <field name="res_model">gabion.panel.override</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a panel length proxy
            </p>
            <p>
                A non-standard length is quoted at the standard length the
                storefront prices it as.
            </p>
        </field>
    </record>

    <menuitem
        id="gabion_panel_override_menu"
        name="Gabion Panel Proxy Lengths"
        parent="sale.menu_sale_config"
        action="gabion_panel_override_action"
        sequence="90"
        groups="base.group_system"/>
</odoo>
