<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
      The storefront's `update_retail_cost()` prices these non-standard panel
      lengths at the next standard length the catalogue sells (the `overrides`
      table). Seed the same map here so the Odoo quote agrees with retail.
      `noupdate="1"`: seeded once; change a row, not this file, once live.
    -->
    <data noupdate="1">
